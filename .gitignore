# ========================================
# base-api 项目 .gitignore
# ========================================


# ------------------------
# 操作系统
# ------------------------
.DS_Store
Thumbs.db
desktop.ini


# ------------------------
# 缓存和临时文件
# ------------------------
/cache/*
!/cache/.gitkeep
*.tmp
*.temp
*.cache

# ------------------------
# 日志文件
# ------------------------
/logs/*
!/logs/.gitkeep
*.log

# ------------------------
# 调试文件
# ------------------------
/debug


# ------------------------
# 业务代码目录（根据实际情况调整）
# ------------------------
# 如果 ga-core 是业务代码，建议纳入版本控制
# 如果是自动生成或敏感数据，则忽略
# /ga-core/*
# !/ga-core/.gitkeep

# ------------------------
# 配置文件（敏感信息）
# ------------------------
# 如果有环境配置文件，建议忽略
.env
.env.local
.env.production
config.local.php
/system/system.php

# ------------------------
# 备份文件
# ------------------------
*.bak
*.backup
*.old
*~

# ------------------------
# 其他
# ------------------------
ga-build
data